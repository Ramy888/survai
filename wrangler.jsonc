{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "survai",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-20",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "d1_databases": [
    { "binding": "DB", "database_name": "survai", "database_id": "aa6238a0-88bd-49ba-98eb-863e42c331da", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "survai-media" }],
  "workflows": [
    { "name": "survai-process", "binding": "PROCESS", "class_name": "ProcessSurvey" },
    { "name": "survai-round", "binding": "ROUND", "class_name": "MeetingRound" }
  ],
  "vars": { "SAM_DAILY_CAP": "600", "MODEL_DAILY_CAP": "1500" }
}
